# Touch intent (generated by Interaction from HAL_EtherCAT touch data)

builtin_interfaces/Time stamp
string body_part            # "hand", "shoulder", "head"
uint8 touch_type
uint8 TOUCH_TYPE_TAP     = 0
uint8 TOUCH_TYPE_HOLD    = 1
uint8 TOUCH_TYPE_SWIPE   = 2
uint8 TOUCH_TYPE_PAT     = 3
float32 pressure
float32 duration_sec
