<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>dr</name>
  <version>0.1.0</version>
  <description>Data Recorder module for humanoid robot</description>
  <maintainer email="dev@striding.ai">Striding Robotics</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>std_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>dr_msgs</depend>
  <depend>sm_msgs</depend>
  <depend>te_msgs</depend>
  <depend>mc_msgs</depend>
  <depend>pnc_msgs</depend>
  <depend>perception_msgs</depend>
  <depend>hds_msgs</depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
